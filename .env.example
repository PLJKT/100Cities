# --- Server ---
PORT=8080
NODE_ENV=development

# --- Database (SQLite 测试；正式可切 MySQL) ---
DB_TYPE=sqlite
DB_FILE=./data/100cities.sqlite

# --- JWT ---
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES=12h

# --- SMTP Mail ---
SMTP_HOST=smtp.yourmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email
SMTP_PASS=your_password
MAIL_FROM="100Cities System <no-reply@yourmail.com>"
MAIL_TO=target_work_mailbox@company.com

# --- WhatsApp API (Business) ---
WA_API_URL=https://api.whatsapp.example
WA_TOKEN=your_token
WA_FROM=+620000000000

# --- Multi-language ---
DEFAULT_LANG=en

# --- Reminder schedule ---
REMIND_EVERY_DAYS=7
ABANDON_AFTER_DAYS=60

# --- Export ---
EXPORT_TMP_DIR=./tmp/export

# --- Initial Super Admin (only used on first boot, then printed once to log) ---
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=ChangeMe!2026
