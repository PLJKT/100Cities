PORT=8080
NODE_ENV=production

DB_TYPE=mysql
DB_HOST=your-rds-host
DB_PORT=3306
DB_NAME=cities100
DB_USER=app_user
DB_PASS=strong_random_password

JWT_SECRET=strong-random-long-secret-string-from-vault
JWT_EXPIRES=12h

SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=smtp_app_password
MAIL_FROM="100Cities <no-reply@yourdomain.com>"
MAIL_TO=target_work_mailbox@yourdomain.com

WA_API_URL=https://graph.whatsapp.example/v15.0
WA_TOKEN=whatsapp_business_token
WA_FROM=+620000000000

DEFAULT_LANG=en
REMIND_EVERY_DAYS=7
ABANDON_AFTER_DAYS=60
EXPORT_TMP_DIR=./tmp/export
